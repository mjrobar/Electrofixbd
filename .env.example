# Node 24; use development for Vite middleware and production for compiled assets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Server-only PostgreSQL connection. Leave empty for frontend-only development;
# writes then return 503. Production requires a real URL and HTTPS PUBLIC_ORIGIN.
DATABASE_URL=
DB_POOL_MAX=5
DB_TIMEOUT_MS=5000
# false by default; loopback only when a trusted local reverse proxy is used.
TRUST_PROXY=false
API_RATE_LIMIT=100
# Existing AI Studio file-watching convention remains supported by Vite.
DISABLE_HMR=false
# Optional separate operator connection for explicit migrations; never auto-run.
MIGRATION_DATABASE_URL=
