# Node 24; use development for Vite middleware and production for compiled assets.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Server-only PostgreSQL connection. Leave empty for frontend-only development;
# writes then return 503. Production requires a real URL and HTTPS PUBLIC_ORIGIN.
DATABASE_URL=
DB_POOL_MAX=5
DB_TIMEOUT_MS=5000
# false by default; loopback only when a trusted local reverse proxy is used.
TRUST_PROXY=false
API_RATE_LIMIT=100
# Existing AI Studio file-watching convention remains supported by Vite.
DISABLE_HMR=false
# Optional separate operator connection for explicit migrations; never auto-run.
MIGRATION_DATABASE_URL=
# Single trusted owner account. Server only; never prefix these with VITE_.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Optional explicit security operator target (no fallback to DATABASE_URL).
# Preview: node --import tsx scripts/secure-database.ts
SECURITY_DATABASE_URL=
RUNTIME_DATABASE_ROLE=
# Set only for a reviewed, explicitly authorized lockdown invocation:
# SECURITY_APPROVAL=REVOKE BROWSER DATABASE ACCESS
# Explicit CIDRs are also supported for TRUST_PROXY. Never use true or /0.
